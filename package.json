{
    "name":  "kiraAI-DeskTop",
    "version":  "2.14.0",
    "description":  "KiraAI Desktop Application",
    "main":  "main.js",
    "author":  "KiraAI Team",
    "license":  "MIT",
    "scripts":  {
                    "start":  "electron .",
                    "build":  "electron-builder --win",
                    "build:dir":  "electron-builder --win --dir",
                    "build:mac":  "electron-builder --mac",
                    "build:mac:arm":  "electron-builder --mac --arm64",
                    "build:mac:x64":  "electron-builder --mac --x64",
                    "postinstall":  "electron-builder install-app-deps"
                },
    "build":  {
                  "appId":  "com.kiraai.desktop",
                  "productName":  "kiraAI-DeskTop",
                  "directories":  {
                                      "output":  "../KiraAI-Dist"
                                  },
                  "asar":  false,
                  "files":  [
                                "main.js",
                                "preload.js",
                                "loading.html",
                                "assets/**/*"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "backend",
                                             "to":  "backend",
                                             "filter":  [
                                                            "**/*",
                                                            "data/dist/**",
                                                            "!**/venv/**",
                                                            "!**/.venv/**",
                                                            "!**/__pycache__/**",
                                                            "!**/*.pyc",
                                                            "!**/build/**",
                                                            "!**/.git/**",
                                                            "!**/node_modules/**",
                                                            "!**/.env",
                                                            "!**/.env.*",
                                                            "!**/*.log",
                                                            "!**/main.spec",
                                                            "!**/.vscode/**",
                                                            "!**/.idea/**",
                                                            "!**/.DS_Store",
                                                            "!**/Thumbs.db",
                                                            "!**/webui/frontend/**",
                                                            "!**/screenshots/**",
                                                            "!**/docs/**",
                                                            "!**/.github/**",
                                                            "!**/Dockerfile",
                                                            "!**/docker-compose.yml",
                                                            "!**/.dockerignore"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "icon":  "assets/KD-LOGO.ico",
                              "requestedExecutionLevel":  "requireAdministrator",
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  false,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "kiraAI-DeskTop",
                               "include":  "build/installer.nsh"
                           },
                  "mac":  {
                              "icon":  "assets/KD-LOGO.icns",
                              "category":  "public.app-category.productivity",
                              "target":  [
                                             {
                                                 "target":  "dmg",
                                                 "arch":  [
                                                              "arm64",
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "hardenedRuntime":  false,
                              "gatekeeperAssess":  false,
                              "identity":  null
                          },
                  "dmg":  {
                              "title":  "kiraAI-DeskTop ${version}",
                              "icon":  "assets/KD-LOGO.icns",
                              "contents":  [
                                               {
                                                   "x":  130,
                                                   "y":  220,
                                                   "type":  "file"
                                               },
                                               {
                                                   "x":  410,
                                                   "y":  220,
                                                   "type":  "link",
                                                   "path":  "/Applications"
                                               }
                                           ]
                          }
              },
    "devDependencies":  {
                            "electron":  "^28.0.0",
                            "electron-builder":  "^24.9.1"
                        },
    "dependencies":  {

                     }
}
