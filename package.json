{
  "name": "KiraAI-Desktop",
  "version": "2.9.1",
  "description": "KiraAI Desktop Application",
  "main": "main.js",
  "author": "KiraAI Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.kiraai.desktop",
    "productName": "KiraAI",
    "directories": {
      "output": "C:\\Users\\Administrator\\Desktop\\PyQt-Fluent-Widgets-master\\KiraAI-Dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/build/**",
          "!**/dist/**",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KiraAI"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {}
}
